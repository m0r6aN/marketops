{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProofpackManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["packId", "tenantId", "createdAtUtc", "runs", "packSha256"],
  "properties": {
    "packId": { "type": "string", "minLength": 1 },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical tenant key. A proofpack seals evidence for exactly one tenant; multi-tenant packs are forbidden."
    },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "mode", "path", "sha256"],
        "properties": {
          "runId": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["dry_run", "prod"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "packSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
