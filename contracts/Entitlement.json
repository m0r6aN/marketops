{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Entitlement",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "plan", "features", "status", "updatedAtUtc"],
  "properties": {
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical tenant key. Entitlements are always evaluated for the requesting tenantId; a lapsed or cancelled entitlement gates beta features off."
    },
    "plan": {
      "type": "string",
      "enum": ["beta", "pilot"]
    },
    "features": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "status": {
      "type": "string",
      "enum": ["active", "lapsed", "cancelled"]
    },
    "expiresAtUtc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "updatedAtUtc": { "type": "string", "format": "date-time" }
  }
}
